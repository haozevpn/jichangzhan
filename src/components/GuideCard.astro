---
const { guide } = Astro.props;
---

<article class="guide-card">
  <p class="card-kicker">{guide.data.category}</p>
  <h2><a href={`/guides/${guide.id}/`}>{guide.data.title}</a></h2>
  <p>{guide.data.description}</p>
  <a class="text-link" href={`/guides/${guide.id}/`}>阅读指南 <span aria-hidden="true">→</span></a>
</article>
