---
const { provider } = Astro.props;
---

<article class="provider-card">
  <div class="provider-card-top">
    <div>
      <p class="card-kicker">第三方目录记录 · 未独立核验</p>
      <h2><a href={`/providers/${provider.slug}/`}>{provider.name}</a></h2>
    </div>
    <span class="status-pill">待核实</span>
  </div>
  <p class="price-quote">{provider.directoryPrice}</p>
  <p>{provider.record}</p>
  <a class="text-link" href={`/providers/${provider.slug}/`}>查看来源、限制与入口状态 <span aria-hidden="true">→</span></a>
</article>
