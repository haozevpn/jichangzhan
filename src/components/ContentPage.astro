---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';

const { title, description, section = '本站信息', noindex = false } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <Breadcrumbs items={[{ label: '首页', href: '/' }, { label: section }, { label: title }]} />
  <article class="prose wrap policy-page">
    <p class="eyebrow">{section}</p>
    <h1>{title}</h1>
    <slot />
  </article>
</BaseLayout>
