---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageIntro from '../../components/PageIntro.astro';
import { hubTopic, topicsUpdatedAt } from '../../data/topics';
import { site } from '../../data/site';

const canonical = new URL('/jichang/', site.origin).toString();

const extraLinks = [
  { slug: 'rankings', name: '机场排行', blurb: '便宜、稳定、性价比等分类的评测口径与当前实测状态。', href: '/rankings/' },
  { slug: 'tizi', name: '梯子推荐 / 翻墙 VPN', blurb: '区分机场订阅与商业 VPN，按设备、预算与条款核对选择。', href: '/tizi/' },
];

const faqs = [
  {
    question: '机场推荐应该怎么选？',
    answer: '先把预算、设备数量、每月用量、主要设备系统和使用时段写成可核对的条件，再从性价比、价格、运营时长、线路类型等角度分别比较候选机场，并逐项核对套餐、退款和隐私条款。不要只按“高速”“老牌”“专线”等宣传词排序。',
  },
  {
    question: '机场、梯子和 VPN 有什么区别？',
    answer: '机场通常指提供代理节点订阅的服务；“梯子”是跨网络连接工具或服务的口语统称；商业 VPN 是独立产品类别。三者在责任边界、客户端和条款上不同，不能混用同一套评分。详见梯子与 VPN 指南。',
  },
  {
    question: '为什么本站不直接给出机场排名？',
    answer: '排名需要可复核的测试样本、清楚的利益披露和一致的比较规则。没有这些时，本站只整理可核对的资料字段和选购口径，不把服务商资料卡排序成榜单，也不编造价格、线路或名次。',
  },
  {
    question: '新手第一次买机场要注意什么？',
    answer: '用可承受的短周期先验证连接、客服与退款，再决定是否加长周期；核对付款主体与官方入口是否一致、设备数与流量倍率是否够用、退款与隐私条款是否写清；关闭不必要的自动续费并保留订单凭证。',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: hubTopic.title,
    description: hubTopic.description,
    keywords: hubTopic.keywords,
    datePublished: topicsUpdatedAt,
    dateModified: topicsUpdatedAt,
    inLanguage: 'zh-CN',
    author: { '@type': 'Organization', name: site.name },
    publisher: { '@type': 'Organization', name: site.name, url: site.origin },
    mainEntityOfPage: canonical,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: '机场推荐分类',
    itemListElement: [...hubTopic.categories.map((c) => ({ href: `/jichang/${c.slug}/`, name: c.name })), ...extraLinks.map((l) => ({ href: l.href, name: l.name }))].map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.name,
      url: new URL(item.href, site.origin).toString(),
    })),
  },
];
---

<BaseLayout title={hubTopic.metaTitle} description={hubTopic.description} keywords={hubTopic.keywords} datePublished={topicsUpdatedAt} dateModified={topicsUpdatedAt} type="article" jsonLd={jsonLd}>
  <Breadcrumbs items={[{ label: '首页', href: '/' }, { label: '机场推荐' }]} />
  <PageIntro eyebrow={hubTopic.eyebrow} title={hubTopic.title} lead={hubTopic.description} />

  <section class="list-section wrap">
    <aside class="direct-answer"><strong>直接回答</strong><p>{hubTopic.directAnswer}</p></aside>

    <div class="list-intro"><h2>按需求分类的机场推荐</h2><p>先确定你的预算与用途，再从下面的分类进入对应的选购口径与候选入口。</p></div>
    <div class="ranking-grid">
      {hubTopic.categories.map((c) => (
        <article class="ranking-step">
          <span>AIRPORT PICKS</span>
          <h3><a href={`/jichang/${c.slug}/`}>{c.name}</a></h3>
          <p>{c.blurb}</p>
        </article>
      ))}
      {extraLinks.map((l) => (
        <article class="ranking-step">
          <span>RELATED</span>
          <h3><a href={l.href}>{l.name}</a></h3>
          <p>{l.blurb}</p>
        </article>
      ))}
    </div>

    <div class="split-panel" style="margin-top:20px">
      <article class="info-panel"><h3>机场资料卡不是排行榜</h3><p>资料卡用于查找注册入口和购买前核对事项，不代表商家确认、当前售价或本站背书。</p><a class="text-link" href="/providers/">查看机场列表 <span aria-hidden="true">→</span></a></article>
      <article class="info-panel accent"><h3>什么情况下才发布机场推荐</h3><p>候选服务需完成重复测试、套餐与条款核验，并公开评分构成、样本范围和局限，才会按需求给出分类建议。</p><a class="text-link" href="/methodology/">查看机场测评方法 <span aria-hidden="true">→</span></a></article>
    </div>

    <div class="risk-alert level-run" style="margin-top:20px">
      <strong>⚠️ 跑路与高危预警</strong>
      <p>以下机场存在停服或高危风险，请勿充值或续费：<a href="/risk/naiyun-shutdown/">奈云（已确认跑路）</a>、<a href="/risk/yinyun-risk/">隐云（高危预警）</a>。更多见 <a href="/risk/">风险预警栏目</a>。</p>
    </div>

    <section class="topic-faq" id="faq">
      <h2>常见问题</h2>
      <dl>
        {faqs.map((faq) => (
          <div class="faq-item">
            <dt>{faq.question}</dt>
            <dd>{faq.answer}</dd>
          </div>
        ))}
      </dl>
    </section>
  </section>
</BaseLayout>
