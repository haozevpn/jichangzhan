---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageIntro from '../../components/PageIntro.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import { providers } from '../../data/providers';
import { overallRanking, rankingCategories, rankingsUpdatedAt } from '../../data/rankings';
import { providerProfiles } from '../../data/providerProfiles';
import { site } from '../../data/site';

const nameOf = new Map(providers.map((p) => [p.slug, p.name]));
const canonical = new URL('/rankings/', site.origin).toString();

const directAnswer = '综合线路类型、套餐性价比、节点覆盖与解锁能力，本站当前的机场推荐排行前两名为极连云与光年梯：极连云主打 IEPL/IPLC 专线、无倍率不限设备、解锁全面，光年梯为全 IPLC 专线、高峰满速且入门价低。下面按综合推荐、性价比机场、便宜机场、老牌机场、专线机场、稳定机场分类给出名次，并链接到各机场资料卡；具体体验请结合服务商页面与自己的测试。';

const faqs = [
  { question: '机场排行第一名是哪个？', answer: '综合排行第一名为极连云：IEPL/IPLC 专线、无倍率、不限速、不限设备，解锁 Netflix、ChatGPT、Gemini 等主流平台，本站 8 折优惠码 JLY888。第二名为光年梯，全 IPLC 专线、高峰满速、入门年付折合 7.5 元/月。' },
  { question: '这个排行是怎么排的？', answer: '按线路类型（IEPL/IPLC/BGP/中转/直连）、套餐性价比、节点覆盖、解锁能力与公开运营背景综合排序，并参考各机场资料整理。排行供选购参考，建议再结合自己的设备、网络和跨时段测试判断。' },
  { question: '便宜的机场一定排名靠前吗？', answer: '不一定。综合排行更看重线路档次与稳定性，价格只是其中一项。预算敏感的用户可看便宜机场分类排行，但低价需结合流量倍率、设备数与稳定性一起判断。' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: '机场推荐排行',
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    itemListElement: overallRanking.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: nameOf.get(item.slug) ?? item.slug,
      url: new URL(`/providers/${item.slug}/`, site.origin).toString(),
    })),
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) },
];
---

<BaseLayout title="机场排行榜｜机场推荐排名、性价比机场与专线机场排行" description="机场排行榜：综合推荐、性价比机场、便宜机场、老牌机场、专线机场与稳定机场分类排名。极连云、光年梯综合排名前二，附各机场线路与入口。" keywords={['机场排行', '机场排名', '机场推荐排行', '机场排行榜', '性价比机场排行', '便宜机场排行', '老牌机场', '专线机场', '稳定机场']} jsonLd={jsonLd}>
  <Breadcrumbs items={[{ label: '首页', href: '/' }, { label: '机场排行榜' }]} />
  <PageIntro eyebrow="AIRPORT & VPN RANKINGS" title="机场排行榜：综合与分类推荐名次" lead="按线路类型、性价比、节点覆盖与解锁能力综合排序，给出机场综合推荐、性价比机场、便宜机场、老牌机场、专线机场与稳定机场的名次。极连云、光年梯为综合推荐前两名。" />
  <section class="list-section wrap">
    <aside class="direct-answer"><strong>直接回答</strong><p>{directAnswer}</p></aside>
    <AffiliateDisclosure />

    <div class="rank-section" id="overall">
      <h2>综合机场推荐排行 TOP 10</h2>
      <ol class="rank-list">
        {overallRanking.map((item, index) => {
          const profile = providerProfiles[item.slug];
          return (
            <li class={`rank-row${index < 2 ? ' rank-top' : ''}`}>
              <span class="rank-num">{index + 1}</span>
              <div class="rank-body">
                <h3><a href={`/providers/${item.slug}/`}>{nameOf.get(item.slug) ?? item.slug}</a>{index === 0 && <em class="rank-badge">推荐第一</em>}{index === 1 && <em class="rank-badge second">推荐第二</em>}</h3>
                {profile?.lineTypes && <p class="rank-line">{profile.lineTypes.join(' / ')}{profile.regions ? `｜${profile.regions}` : ''}</p>}
                <p class="rank-reason">{item.reason}</p>
              </div>
              <a class="button button-primary rank-cta" href={`/providers/${item.slug}/`}>查看资料 →</a>
            </li>
          );
        })}
      </ol>
    </div>

    {rankingCategories.map((cat) => (
      <div class="rank-section" id={cat.key}>
        <div class="rank-cat-head">
          <div><p class="eyebrow">{cat.eyebrow}</p><h2>{cat.title}</h2><p class="rank-cat-intro">{cat.intro}</p></div>
          {cat.href && <a class="text-link" href={cat.href}>查看{cat.title.replace('排行', '')}选购口径 →</a>}
        </div>
        <ol class="rank-list rank-list-compact">
          {cat.items.map((item, index) => (
            <li class="rank-row">
              <span class="rank-num">{index + 1}</span>
              <div class="rank-body">
                <h3><a href={`/providers/${item.slug}/`}>{nameOf.get(item.slug) ?? item.slug}</a></h3>
                <p class="rank-reason">{item.reason}</p>
              </div>
              <a class="text-link rank-cta" href={`/providers/${item.slug}/`}>查看 →</a>
            </li>
          ))}
        </ol>
      </div>
    ))}

    <div class="split-panel" style="margin-top:28px">
      <article class="info-panel"><h3>排行如何得出</h3><p>名次综合线路类型、套餐性价比、节点覆盖、解锁能力与公开运营背景整理，并参考各机场资料。供选购参考，不替代你在自己设备与网络下的测试。</p><a class="text-link" href="/methodology/">查看测评方法 <span aria-hidden="true">→</span></a></article>
      <article class="info-panel accent"><h3>先看风险再下单</h3><p>部分机场存在停服或高危风险，购买前请查看风险预警，并用付款周期控制预付金额。</p><a class="text-link" href="/risk/">查看风险预警 <span aria-hidden="true">→</span></a></article>
    </div>

    <section class="topic-faq" id="faq">
      <h2>常见问题</h2>
      <dl>
        {faqs.map((faq) => (
          <div class="faq-item"><dt>{faq.question}</dt><dd>{faq.answer}</dd></div>
        ))}
      </dl>
    </section>
  </section>
</BaseLayout>
