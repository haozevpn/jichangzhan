---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageIntro from '../../components/PageIntro.astro';
import ProviderCard from '../../components/ProviderCard.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import { providers } from '../../data/providers';
---

<BaseLayout title="机场列表｜机场与网络服务入口" description="机场服务商资料列表与注册入口，整理线路类型、覆盖地区与套餐资料，并按需求提供机场排行。">
  <Breadcrumbs items={[{ label: '首页', href: '/' }, { label: '机场列表' }]} />
  <PageIntro eyebrow="AIRPORT LIST / 服务商索引" title="机场列表与注册入口" lead="这里按名称整理机场与网络服务商资料卡，含线路类型、覆盖地区与套餐资料，方便查找对应入口。价格、条款与实际体验以服务商页面和你自己的测试为准；按名次查看请前往机场排行。" />
  <section class="list-section wrap">
    <AffiliateDisclosure />
    <div class="list-intro"><h2>服务商资料卡 · {providers.length}</h2><p>按名称整理机场资料与注册入口；按名次查看请前往 <a href="/rankings/">机场排行</a>。</p></div>
    <div class="provider-grid">{providers.map((provider) => <ProviderCard provider={provider} />)}</div>
  </section>
</BaseLayout>
