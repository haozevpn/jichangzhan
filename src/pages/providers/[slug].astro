---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { providers } from '../../data/providers';
import { providerProfiles, providerWarnings } from '../../data/providerProfiles';
import { providerContent } from '../../data/providerContent';

export function getStaticPaths() {
  return providers.map((provider) => ({ params: { slug: provider.slug }, props: { provider } }));
}

const { provider } = Astro.props;
const profile = providerProfiles[provider.slug];
const warning = providerWarnings[provider.slug];
const content = providerContent[provider.slug];
const isRun = warning?.level === '跑路';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `${provider.name} · 服务商资料卡`,
  description: warning ? `${provider.name}：${warning.summary}（本站风险预警）。` : `${provider.name}的注册入口、线路资料与选购核对事项。`,
  inLanguage: 'zh-CN',
};
---

<BaseLayout title={warning ? `${provider.name}${warning.level}预警` : `${provider.name}资料卡`} description={warning ? `${provider.name}${warning.level}预警：${warning.summary}。${provider.name}的风险提示与选购核对事项。` : `${provider.name}注册入口、线路类型、覆盖地区、套餐资料与选购核对事项。`} noindex={true} jsonLd={jsonLd}>
  <Breadcrumbs items={[{ label: '首页', href: '/' }, { label: '机场列表', href: '/providers/' }, { label: provider.name }]} />
  <section class="page-intro wrap">
    <p class="eyebrow">PROVIDER PROFILE / 编辑资料卡</p>
    <h1>{provider.name}：{warning ? `${warning.level}预警与风险提示` : '资料卡、线路与选购核对'}</h1>
    <p class="lede">{warning ? `本站根据公开监测对 ${provider.name} 发出${warning.level}预警。` : `${provider.name} 的线路类型、覆盖地区、套餐资料与购买前核对事项整理如下。价格、条款与服务表现以服务商页面和你自己的测试为准。`}</p>
  </section>
  <section class="provider-detail wrap">
    {warning && (
      <div class={`risk-alert ${warning.level === '跑路' ? 'level-run' : 'level-high'}`}>
        <strong>⚠️ {warning.level}预警：{warning.summary}</strong>
        <p>{warning.detail}</p>
        <p class="risk-alert-links"><a href="/risk/">查看风险预警栏目</a> · <a href="/risk/airport-shutdown/">如何用付款周期控制预付风险</a></p>
      </div>
    )}
    <div class="provider-detail-grid">
      <div>
        {profile && (profile.lineTypes || profile.regions) && (
          <div class="provider-facts">
            {profile.lineTypes && <div class="fact-box"><small>线路类型</small><strong>{profile.lineTypes.join(' / ')}</strong></div>}
            {profile.regions && <div class="fact-box"><small>覆盖地区</small><strong>{profile.regions}</strong></div>}
            {profile.since && <div class="fact-box"><small>运营背景</small><strong>{profile.since}</strong></div>}
            {profile.refund && <div class="fact-box"><small>退款/试用</small><strong>{profile.refund}</strong></div>}
          </div>
        )}
        <div class="prose">
          {content?.intro && (
            <>
              <h2>{provider.name} 机场简介</h2>
              {content.intro.map((paragraph) => <p>{paragraph}</p>)}
            </>
          )}

          {content?.features && content.features.length > 0 && (
            <>
              <h2>核心特性</h2>
              <ul>{content.features.map((feature) => <li>{feature}</li>)}</ul>
            </>
          )}

          {content?.plans && content.plans.length > 0 && (
            <>
              <h2>套餐与价格（资料参考）</h2>
              <p class="table-note">以下套餐资料参考 clash-jichang.com/airport/ 整理，仅供比较；实际价格、流量与规则以服务商页面为准。</p>
              <table>
                <thead><tr><th>套餐</th><th>价格</th><th>流量</th><th>说明</th></tr></thead>
                <tbody>
                  {content.plans.map((plan) => (
                    <tr><td>{plan.name}</td><td>{plan.price}</td><td>{plan.traffic}</td><td>{plan.note ?? '—'}</td></tr>
                  ))}
                </tbody>
              </table>
              {content.payment && <p class="table-note">支付方式：{content.payment}</p>}
            </>
          )}

          <h2>购买前建议逐项确认</h2>
          <ul>
            <li>结账总价、首购优惠结束后的续费价格、流量与重置周期，以及流量倍率口径。</li>
            <li>可同时在线的设备数、兼容客户端、退款条件、试用规则和自动续费设置。</li>
            <li>隐私政策、客服渠道、账户注销方式，以及付款页面显示的运营主体是否与官网一致。</li>
            <li>线路与节点是否覆盖你需要的地区，是否支持你常用的目标服务（流媒体、AI 平台等）。</li>
            <li>如果要判断速度或稳定性，请在自己的设备和网络环境下、跨不同时段重复测试，并保留时间、样本与失败记录。</li>
          </ul>

          <p>本页资料用于帮助你在购买前做横向比较与了解 {provider.name} 的线路与套餐。促销价格、永久套餐、限时名额等信息变动较快，下单前请以服务商当前页面为准，并优先选择可承受的短周期进行验证。各分类名次见<a href="/rankings/">机场排行</a>。</p>

          {content?.faqs && content.faqs.length > 0 && (
            <section class="topic-faq" id="faq">
              <h2>{provider.name} 常见问题</h2>
              <dl>
                {content.faqs.map((faq) => (
                  <div class="faq-item"><dt>{faq.question}</dt><dd>{faq.answer}</dd></div>
                ))}
              </dl>
            </section>
          )}
        </div>
      </div>
      <aside class="entry-box">
        {isRun ? (
          <>
            <h2>注册入口已关闭</h2>
            <p>该服务已确认跑路，注册入口与节点均已失效，本站不再提供入口链接。请勿充值或续费。</p>
          </>
        ) : (
          <>
            <h2>注册入口</h2>
            {warning
              ? <p>该服务处于高危预警状态，如仍要访问请谨慎，并避免预付长周期套餐。</p>
              : <p>外链由站点运营者提供，部分链接含推广参数。打开后请核对地址栏和页面信息。</p>}
            <ul class="provider-link-list">{provider.registerLinks.map((link) => <li><a class="button button-primary" href={link.url} target="_blank" rel="sponsored nofollow noopener noreferrer">{link.label} ↗</a></li>)}</ul>
            {provider.extraLinks && <><h3 class="entry-subheading">其他入口</h3><ul class="provider-link-list">{provider.extraLinks.map((link) => <li><a href={link.url} target="_blank" rel="nofollow noopener noreferrer">{link.label} ↗</a></li>)}</ul></>}
            {provider.coupon && <p><strong>优惠码：</strong>{provider.coupon}</p>}
            <p><a href="/disclosure/">查看本站商业关系披露</a></p>
          </>
        )}
      </aside>
    </div>
  </section>
</BaseLayout>
