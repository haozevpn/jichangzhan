---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideCard from '../components/GuideCard.astro';
import ProviderCard from '../components/ProviderCard.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import { providers } from '../data/providers';
import { site } from '../data/site';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const featuredGuides = guides.slice(0, 3);
const featuredProviders = providers.slice(0, 3);
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: site.name, url: site.origin },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.origin, inLanguage: 'zh-CN' },
];
---

<BaseLayout title={site.title} description={site.description} keywords={['机场推荐', '梯子推荐', '翻墙VPN推荐', '科学上网', '科学上网工具', '性价比VPN', '便宜机场', '稳定机场', '机场排行', 'VPN排行']} jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">AIRPORT GUIDE · REVIEW NOTES</p>
        <h1>机场推荐排行｜<br /><em>梯子推荐、翻墙VPN与科学上网指南</em></h1>
        <p class="hero-lede">围绕机场推荐、梯子推荐、翻墙 VPN、科学上网和性价比选择整理原创指南与机场排行，覆盖性价比机场、便宜机场、老牌机场与专线机场的选购口径。</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/providers/">查看机场列表 <span aria-hidden="true">→</span></a>
          <a class="button button-outline" href="/rankings/">查看分类排行</a>
        </div>
      </div>
      <aside class="hero-card" aria-label="资料状态">
        <div class="hero-card-top"><span>REVIEW STANDARD / 01</span><span class="dot-status">分类清晰，入口透明</span></div>
        <ul class="signal-list">
          <li><span class="signal-number">01</span><div><strong>机场资料独立整理</strong><small>线路类型、覆盖地区与套餐资料分类呈现，注册入口单独标注。</small></div></li>
          <li><span class="signal-number">02</span><div><strong>分类排行可查</strong><small>按性价比、便宜、老牌、专线、稳定分类给出名次与选购口径。</small></div></li>
          <li><span class="signal-number">03</span><div><strong>风险优先提示</strong><small>跑路与高危机场显著预警，建议用付款周期控制预付风险。</small></div></li>
        </ul>
      </aside>
    </div>
  </section>
  <section class="notice-band">
    <div class="wrap notice-inner"><strong>推荐说明</strong><p>便宜机场、稳定机场和性价比机场使用不同比较口径，可在机场排行按需求查看名次。注册入口部分含推广参数，下单前请核对服务商页面与条款。</p></div>
  </section>
  <section class="section wrap">
    <div class="section-heading"><div><p class="eyebrow">AIRPORT LIST / 01</p><h2>机场列表、机场推荐与 VPN 分类排行</h2><p>从机场列表进入机场推荐、便宜机场、稳定机场与性价比 VPN 分类；先看比较口径和证据状态，再决定哪些选项适合自己的预算与设备。</p></div></div>
    <div class="card-grid topic-hub-grid">
      <article class="guide-card"><p class="card-kicker">AIRPORT PICKS</p><h2><a href="/jichang/">机场推荐</a></h2><p>按性价比机场、便宜机场、老牌机场、专线机场分类的选购口径与候选入口。</p><a class="text-link" href="/jichang/">查看机场推荐 →</a></article>
      <article class="guide-card"><p class="card-kicker">AIRPORT LIST</p><h2><a href="/providers/">机场列表</a></h2><p>查看机场服务商资料卡、注册入口和购买前核对事项。</p><a class="text-link" href="/providers/">查看机场列表 →</a></article>
      <article class="guide-card"><p class="card-kicker">LADDER / VPN GUIDE</p><h2><a href="/tizi/">梯子推荐与翻墙 VPN 推荐</a></h2><p>区分机场服务与 VPN 产品，按设备、预算、条款及当地适用规则核对选择条件。</p><a class="text-link" href="/tizi/">阅读梯子与 VPN 指南 →</a></article>
      <article class="guide-card"><p class="card-kicker">AIRPORT & VPN RANKINGS</p><h2><a href="/rankings/">机场排行：便宜、稳定与综合分类</a></h2><p>查看便宜机场、稳定机场、性价比 VPN 等分类的评测口径与当前实测状态。</p><a class="text-link" href="/rankings/">查看分类排行 →</a></article>
      <article class="guide-card"><p class="card-kicker">CLIENTS</p><h2><a href="/clients/">客户端使用教程</a></h2><p>按系统和订阅格式了解规则、系统代理、TUN、DNS 与日志检查。</p><a class="text-link" href="/clients/">查看客户端 →</a></article>
      <article class="guide-card"><p class="card-kicker">NETWORK</p><h2><a href="/network/">网络故障排查</a></h2><p>从连接超时、DNS、TLS 到订阅更新，按现象逐层排查。</p><a class="text-link" href="/network/">排查故障 →</a></article>
      <article class="guide-card"><p class="card-kicker">AI PLATFORMS</p><h2><a href="/ai/">AI 工具网络指南</a></h2><p>按平台查看连接条件、客户端网络路径与常见故障排查。</p><a class="text-link" href="/ai/">查看专题 →</a></article>
    </div>
  </section>
  <section class="section wrap">
    <div class="section-heading">
      <div><p class="eyebrow">AIRPORT BUYING GUIDE / 02</p><h2>机场推荐指南与选购条件</h2><p>从预算、条款、设备和测试限制出发，建立自己的比较标准。</p></div>
      <a class="text-link" href="/guides/">浏览机场推荐指南 <span aria-hidden="true">→</span></a>
    </div>
    <div class="card-grid">
      {featuredGuides.map((guide) => <GuideCard guide={guide} />)}
    </div>
  </section>
  <section class="section" style="background:#edf1ea">
    <div class="wrap">
      <div class="section-heading">
        <div><p class="eyebrow">PROVIDER NOTES / 02</p><h2>服务商资料，先看入口和限制</h2><p>以下资料卡由本站整理注册入口和购买前核对事项，不发布未经核实的价格或服务表现。</p></div>
        <a class="text-link" href="/providers/">查看机场列表 <span aria-hidden="true">→</span></a>
      </div>
      <AffiliateDisclosure />
      <div class="card-grid">{featuredProviders.map((provider) => <ProviderCard provider={provider} />)}</div>
      <p class="home-source">本站仅整理名称、注册入口和购买前核对事项；套餐价格、服务条款和服务表现请以注册后的页面及你自己的测试为准。</p>
    </div>
  </section>
  <section class="section wrap">
    <div class="section-heading"><div><p class="eyebrow">HOW WE READ / 03</p><h2>一条信息，四种状态</h2><p>读者可以分辨来源类型，避免把广告用语误读成独立结论。</p></div></div>
    <div class="split-panel">
      <article class="info-panel"><h3>博客内容独立整理</h3><p>文章按选购问题、客户端和网络故障组织，注册入口单独披露推广关系，不把广告用语写成独立测试结论。</p><a class="text-link" href="/about/">了解本站定位 <span aria-hidden="true">→</span></a></article>
      <article class="info-panel accent"><h3>测评结果可复核</h3><p>每项服务表现结论都应列明设备、网络、测试窗口、样本和证据；评分采用固定口径，并呈现失败样本与适用限制。</p><a class="text-link" href="/methodology/">查看测评方法 <span aria-hidden="true">→</span></a></article>
    </div>
  </section>
</BaseLayout>
