---
import EditorialArticlePage from '../../components/EditorialArticlePage.astro';
import { clientGuides, editorialDate } from '../../data/editorial';

export function getStaticPaths() {
  return clientGuides.map((client) => ({
    params: { slug: client.slug },
    props: { article: { slug: client.slug, title: `${client.name} 使用教程：导入、分流与故障排查`, description: client.summary, keywords: client.keywords, category: '客户端教程', updatedAt: editorialDate, sections: client.sections } },
  }));
}

const { article } = Astro.props;
const related = clientGuides.filter((client) => client.slug !== article.slug).slice(0, 6).map((client) => ({ title: `${client.name} 使用指南`, href: `/clients/${client.slug}/` }));
---

<EditorialArticlePage article={article} sectionUrl="/clients/" sectionLabel="客户端" related={related} />
